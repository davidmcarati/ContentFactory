# --- Environments ---------------------------------------------------------
.venv*/
__pycache__/
*.py[cod]

# --- ComfyUI ---------------------------------------------------------------
# Cloned at setup time, not vendored. See DEPENDENCY.md.
# The model-paths file we own lives in config/, not in here: git cannot
# un-ignore a file inside an ignored directory, so keeping it there would have
# silently dropped it from the repo.
/comfy/

# --- Working material ------------------------------------------------------
# Scripts, storyboards, narration, frames and clips live with the video they
# made, in D:/TheArtOfChaosVideos/<video>/sources, not in here. These rules
# are a backstop for a project directory recreated locally by accident: there
# should be nothing to ignore.
/projects/

# Scratch space for the smoke test.
/.smoketest/

# --- Local assets ----------------------------------------------------------
# Licensed fonts and music are not ours to redistribute.
assets/fonts/*
assets/music/*
!assets/**/.gitkeep

# --- Runtime ---------------------------------------------------------------
logs/
*.log
